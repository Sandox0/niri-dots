#!/bin/sh
#---------------------------------------------
#   xdg-update-desktop-database
#
#   Helper script to work around the known issue of update-desktop-database not
#   automatically updating the users local mimeinfo.cache. And xdg-menu-item only
#   calling update-desktop-database if its a system install
#
#   https://gitlab.freedesktop.org/xdg/desktop-file-utils/-/issues/54
#
#---------------------------------------------

exit_success()
{
    if [ $# -gt 0 ]; then
        echo "$@"
        echo
    fi

    exit 0
}


update_desktop_database()
{
#    echo Update desktop database: $mode
    for x in `echo $PATH | sed 's/:/ /g'` /opt/gnome/bin; do
       if [ -x $x/update-desktop-database ] ; then
#          DEBUG 1 "Running $x/update-desktop-database"
          eval '$x/update-desktop-database'
          eval '$x/update-desktop-database ${XDG_DATA_HOME:-$HOME/.local/share}/applications'
          return
       fi
    done
}


update_desktop_database

exit_success
