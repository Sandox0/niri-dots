// Generated by Tide Island. Edit shortcuts in the Tide Island config app.
// These binds call Quickshell IPC; the same commands can be reused in scripts.
binds {
    Super+Shift+Right { spawn "/usr/bin/quickshell" "ipc" "--any-display" "-p" "/usr/share/tide-island" "call" "tide" "swipeRight"; }
    Super+Shift+Left { spawn "/usr/bin/quickshell" "ipc" "--any-display" "-p" "/usr/share/tide-island" "call" "tide" "swipeLeft"; }
    Super+Shift+Down { spawn "/usr/bin/quickshell" "ipc" "--any-display" "-p" "/usr/share/tide-island" "call" "tide" "showClock"; }
    Super+Shift+M { spawn "/usr/bin/quickshell" "ipc" "--any-display" "-p" "/usr/share/tide-island" "call" "tide" "togglePlayer"; }
    Super+Shift+C { spawn "/usr/bin/quickshell" "ipc" "--any-display" "-p" "/usr/share/tide-island" "call" "tide" "toggleControlCenter"; }
    Super+Shift+N { spawn "/usr/bin/quickshell" "ipc" "--any-display" "-p" "/usr/share/tide-island" "call" "tide" "toggleNotificationCenter"; }
    Super+Shift+W { spawn "/usr/bin/quickshell" "ipc" "--any-display" "-p" "/usr/share/tide-island" "call" "tide" "toggleWallpaperPicker"; }
    Super+Shift+A { spawn "/usr/bin/quickshell" "ipc" "--any-display" "-p" "/usr/share/tide-island" "call" "tide" "toggleApplicationLauncher"; }
    Super+Shift+F { spawn "/usr/bin/quickshell" "ipc" "--any-display" "-p" "/usr/share/tide-island" "call" "island" "toggle"; }
}
